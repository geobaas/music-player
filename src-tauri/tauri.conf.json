{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "music-player",
  "version": "0.1.0",
  "identifier": "com.geova.music-player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "music-player",
        "width": 800,
        "height": 600
      },
      {
        "label": "mini",
        "title": "Mini reproductor",
        "url": "index.html?mini",
        "width": 300,
        "height": 84,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
